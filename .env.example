# Optional environment overrides. Copy this file to .env when needed.
LEETTUTOR_PROVIDER=Ollama
LEETTUTOR_OLLAMA_URL=http://localhost:11434
LEETTUTOR_LM_STUDIO_URL=http://localhost:1234/v1
LEETTUTOR_AMD_METAL_URL=http://127.0.0.1:11435/v1
LEETTUTOR_MODEL=qwen3.5:9b
# LEETTUTOR_API_KEY=only-if-your-local-server-requires-one

# Cloud APIs use separate API products and billing from ChatGPT/Gemini web plans.
# LEETTUTOR_OPENAI_API_KEY=sk-...
# LEETTUTOR_GEMINI_API_KEY=...
# Official endpoints can be overridden for advanced proxy setups only:
# LEETTUTOR_OPENAI_URL=https://api.openai.com/v1
# LEETTUTOR_GEMINI_URL=https://generativelanguage.googleapis.com/v1beta/openai

# Host mode generates a new code each time. Trusted browsers can remember the
# host for 30 days without storing this code. Set a fixed code only for a
# controlled deployment and never commit a real value.
# LEETTUTOR_ACCESS_CODE=12345678
